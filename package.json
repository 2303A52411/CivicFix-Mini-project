{
  "name": "civicfix",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["server", "client"],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "test": "npm test -w server && npm test -w client",
    "seed": "npm run seed -w server",
    "verify:persistence": "npm run verify:persistence -w server",
    "start": "npm start -w server"
  },
  "devDependencies": {"concurrently": "^9.1.2"}
}
